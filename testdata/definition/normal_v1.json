{
  "algorithm": "inofy-normal-v1",
  "rules": {
    "object_keys": "sorted by UTF-8 byte order (Go encoding/json order)",
    "nodes": "array under any graph sorted by id",
    "edges": "array under any graph sorted by (from, port, to)",
    "exits": "sorted (a set, not an ordered list)",
    "candidates": "sorted by (source, pointer)",
    "cases_and_args": "authored order preserved",
    "numbers": "finite binary64; integral values beyond +/-2^53-1 rejected; -0 becomes 0; integral values emit integer form",
    "strings": "Unicode code points preserved; no HTML escaping; no Unicode normalization",
    "encoding": "encoding/json compatible, SetEscapeHTML(false), no indentation, no trailing newline"
  },
  "cases": [
    {
      "name": "object_key_order",
      "doc": {
        "b": 1,
        "a": {
          "d": 2,
          "c": 3
        }
      },
      "normalized": "{\"a\":{\"c\":3,\"d\":2},\"b\":1}"
    },
    {
      "name": "node_id_sort",
      "doc": {
        "graph": {
          "nodes": [
            {
              "id": "b"
            },
            {
              "id": "a"
            }
          ]
        }
      },
      "normalized": "{\"graph\":{\"nodes\":[{\"id\":\"a\"},{\"id\":\"b\"}]}}"
    },
    {
      "name": "edge_triple_sort",
      "doc": {
        "graph": {
          "edges": [
            {
              "from": "b",
              "to": "a"
            },
            {
              "from": "a",
              "to": "b"
            },
            {
              "from": "a",
              "port": "p",
              "to": "a"
            },
            {
              "from": "a",
              "to": "a"
            }
          ]
        }
      },
      "normalized": "{\"graph\":{\"edges\":[{\"from\":\"a\",\"to\":\"a\"},{\"from\":\"a\",\"to\":\"b\"},{\"from\":\"a\",\"port\":\"p\",\"to\":\"a\"},{\"from\":\"b\",\"to\":\"a\"}]}}"
    },
    {
      "name": "exits_sort",
      "doc": {
        "graph": {
          "exits": [
            "z",
            "a"
          ]
        }
      },
      "normalized": "{\"graph\":{\"exits\":[\"a\",\"z\"]}}"
    },
    {
      "name": "candidates_sort",
      "doc": {
        "graph": {
          "nodes": [
            {
              "id": "s",
              "candidates": [
                {
                  "source": "b",
                  "pointer": "/o"
                },
                {
                  "source": "a",
                  "pointer": "/o"
                }
              ]
            }
          ]
        }
      },
      "normalized": "{\"graph\":{\"nodes\":[{\"candidates\":[{\"pointer\":\"/o\",\"source\":\"a\"},{\"pointer\":\"/o\",\"source\":\"b\"}],\"id\":\"s\"}]}}"
    },
    {
      "name": "negative_zero",
      "doc": {
        "x": 0
      },
      "normalized": "{\"x\":0}"
    },
    {
      "name": "html_escape_off",
      "doc": {
        "s": "<a>&\u2028"
      },
      "normalized": "{\"s\":\"<a>&\\u2028\"}"
    },
    {
      "name": "unicode_preserved",
      "doc": {
        "s": "héllo·世界"
      },
      "normalized": "{\"s\":\"héllo·世界\"}"
    },
    {
      "name": "safe_int_boundary",
      "doc": {
        "max": 9007199254740991,
        "min": -9007199254740991
      },
      "normalized": "{\"max\":9007199254740991,\"min\":-9007199254740991}"
    },
    {
      "name": "unsafe_integer_reject",
      "doc": {
        "v": 9007199254740992
      },
      "reject": "unsafe_integer"
    },
    {
      "name": "unsafe_exponent_reject",
      "doc": {
        "v": 1e+20
      },
      "reject": "unsafe_integer"
    },
    {
      "name": "non_finite_reject",
      "doc": {
        "v": 1e400
      },
      "reject": "non_finite"
    },
    {
      "name": "float_integral_form",
      "doc": {
        "x": 3.0
      },
      "normalized": "{\"x\":3}"
    },
    {
      "name": "float_short_forms",
      "doc": {
        "x": 0.5,
        "y": 3.14,
        "z": 0.001
      },
      "normalized": "{\"x\":0.5,\"y\":3.14,\"z\":0.001}"
    },
    {
      "name": "null_distinct",
      "doc": {
        "a": null
      },
      "normalized": "{\"a\":null}"
    },
    {
      "name": "empty_containers",
      "doc": {
        "a": [],
        "o": {}
      },
      "normalized": "{\"a\":[],\"o\":{}}"
    },
    {
      "name": "nested_graph_sort",
      "doc": {
        "graph": {
          "nodes": [
            {
              "id": "r",
              "kind": "repeat",
              "body": {
                "nodes": [
                  {
                    "id": "b2"
                  },
                  {
                    "id": "b1"
                  }
                ]
              }
            }
          ]
        }
      },
      "normalized": "{\"graph\":{\"nodes\":[{\"body\":{\"nodes\":[{\"id\":\"b1\"},{\"id\":\"b2\"}]},\"id\":\"r\",\"kind\":\"repeat\"}]}}"
    },
    {
      "name": "exponent_normalize",
      "doc": {
        "v": 100.0
      },
      "normalized": "{\"v\":100}"
    },
    {
      "name": "negative_float",
      "doc": {
        "v": -2.5
      },
      "normalized": "{\"v\":-2.5}"
    }
  ]
}
